# PostgreSQL connection (read access is enough — whydid never writes,
# except `whydid seed` which creates the demo table)
DATABASE_URL=postgres://whydid:whydid@localhost:5433/whydid

# LLM — any OpenAI-compatible chat-completions endpoint with tool calling.
# Defaults to OpenRouter. Examples:
#   OpenRouter: https://openrouter.ai/api/v1   model: anthropic/claude-sonnet-4.5
#   OpenAI:     https://api.openai.com/v1      model: gpt-4.1
WHYDID_LLM_BASE_URL=https://openrouter.ai/api/v1
WHYDID_LLM_API_KEY=
WHYDID_LLM_MODEL=anthropic/claude-sonnet-4.5

# Behind a proxy? Node 24+ can route fetch through it:
#   export HTTPS_PROXY=http://127.0.0.1:7890
#   export NODE_USE_ENV_PROXY=1
